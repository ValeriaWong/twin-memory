# Twin Memory — config template. Copy to .env and fill in YOUR OWN values.
# NEVER commit .env. NEVER paste a real key into chat, a doc, or the repo.
# Leave MEKO_* blank to run in offline mock mode (the default).

# live | mock  (default: mock)
MEKO_MODE=mock
# Meko Cloud MCP endpoint (verified in Meko docs, 2026-11-20).
MEKO_MCP_URL=https://mcp.mekodata.ai/mcp
# Datapack created by Allen in the Meko portal.
MEKO_DATAPACK_ID=twin-memory
# API key generated by Allen in Meko Settings > API Keys.
# Keys start with mko_tkn_ and are shown once. Put the full key here only.
MEKO_API_KEY=

# LLM (optional). The demo runs without any of these, using the offline MockLLM.
# LLM_PROVIDER=mock
# LLM_MODEL=
# LLM_API_KEY=
